# Backend-only secrets. Do not expose these values to the frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# MiniMax (OpenAI-compatible) provider. Fill the API key below before enabling.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

MINERU_BASE_URL=
MINERU_BACKEND=
MINERU_TIMEOUT_SECONDS=

ORACLE_DSN=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=ORACLE_HOST)(PORT=1521))(CONNECT_DATA=(SID=ORACLE_SID)))
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_CLIENT_LIB_DIR=
ORACLE_TIMEOUT_SECONDS=

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DsAgents

CORS_ORIGINS=http://localhost:8500,http://127.0.0.1:8500
