# Backend-only secrets. Do not expose these values to the frontend.
# MiniMax (Anthropic-compatible) provider. Fill the API key below before enabling.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3

MINERU_BASE_URL=http://10.11.0.110:6006
MINERU_BACKEND=vlm-engine
MINERU_EFFORT=
MINERU_TIMEOUT_SECONDS=7200

# Optional shared 12NC customs-unit lookup for WGQ and DK. Leave credentials empty to use manual-check fallback.
# Windows checkout includes backend/.oracle/instantclient/instantclient_19_31 and uses it automatically.
# Set ORACLE_CLIENT_LIB_DIR only to override the bundled Instant Client path.
ORACLE_DSN=
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_CLIENT_LIB_DIR=
ORACLE_TIMEOUT_SECONDS=30
