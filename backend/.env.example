# Backend-only secrets. Do not expose these values to the frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# MiniMax (Anthropic-compatible) provider. Fill the API key below before enabling.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3

MINERU_BASE_URL=http://10.11.0.110:6006
MINERU_BACKEND=hybrid-engine
MINERU_EFFORT=high
MINERU_TIMEOUT_SECONDS=900

ORACLE_DSN=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=ORACLE_HOST)(PORT=1521))(CONNECT_DATA=(SID=ORACLE_SID)))
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_CLIENT_LIB_DIR=
ORACLE_TIMEOUT_SECONDS=

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DsAgents

CORS_ORIGINS=http://localhost:8500,http://127.0.0.1:8500
